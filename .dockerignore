# Docker matches these against the path from the context root, so a bare
# `node_modules` excludes only the top-level one — a nested copy (a git
# worktree beside the repo, say) sails straight into the build context. `**/`
# is what makes a rule mean "anywhere".
**/node_modules
**/.nuxt
**/.output
**/dist
**/.data
**/*.log

# Worktrees created by tooling alongside the repo.
.worktrees

.git
.github

# Secrets never belong in a build context, at any depth.
**/.env
**/.env.*

# Not needed to build the site: the deploy manifest is documentation and scratch
# is run output.
docs
deploy
scratch

# `onion` itself is IN the context — it builds the gateway that ships in this
# image. Only its outputs are excluded: `target` is gigabytes of build cache,
# and `tor` is a live onion identity key, which has no business in a build
# context that gets shipped around and cached.
onion/target
onion/tor
